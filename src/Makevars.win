# lapack_rcond.cpp calls LAPACK's dpocon directly, so the package links
# against R's own LAPACK and BLAS rather than carrying a copy of either;
# wcrossprod.cpp runs on RcppParallel, whose libraries are appended.
PKG_CXXFLAGS += -DRCPP_PARALLEL_USE_TBB=1
PKG_LIBS = $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS) $(shell "${R_HOME}/bin${R_ARCH_BIN}/Rscript.exe" -e "RcppParallel::RcppParallelLibs()")
